{
  "name": "Clínicas-Escola",
  "dataColors": [
    "#2B2D33",
    "#F2652F",
    "#A3A7AF",
    "#F7A27F",
    "#5B5F67",
    "#FBD8C8",
    "#80848C",
    "#D9DBDF"
  ],
  "background": "#FFFFFF",
  "foreground": "#131417",
  "tableAccent": "#F2652F",
  "good": "#2B2D33",
  "neutral": "#A3A7AF",
  "bad": "#F2652F",
  "maximum": "#F2652F",
  "center": "#F7A27F",
  "minimum": "#FDEDE6",
  "null": "#E5E7EB",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#131417",
      "fontSize": 12
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#5B5F67"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#131417",
      "fontSize": 28
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#131417"
              }
            },
            "bold": true,
            "fontSize": 12
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B5F67"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B5F67"
              }
            },
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B5F67"
              }
            },
            "position": "TopRight"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "radius": 16
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 14,
            "right": 14
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#E7E8EA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#131417"
              }
            },
            "fontSize": 28
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5B5F67"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#5B5F67"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#ECEDEF"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#5B5F67"
              }
            },
            "fontSize": 13,
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontSize": 13
          }
        ],
        "values": [
          {
            "fontSize": 13
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    }
  }
}
