{
  "name": "Clínicas-Escola",
  "dataColors": [
    "#1F4E79",
    "#E85A5A",
    "#2E8B6E",
    "#C9A227",
    "#7A5C99",
    "#5DA9C9",
    "#9C6644",
    "#8D99AE"
  ],
  "background": "#FFFFFF",
  "foreground": "#14213D",
  "tableAccent": "#1F4E79",
  "good": "#2E8B6E",
  "neutral": "#C9A227",
  "bad": "#E85A5A",
  "maximum": "#E85A5A",
  "center": "#F4B8B8",
  "minimum": "#FCEDED",
  "null": "#E5E7EB",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#14213D",
      "fontSize": 12
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#4A5568"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#14213D",
      "fontSize": 26
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#14213D"
              }
            },
            "bold": true,
            "fontSize": 12
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#4A5568"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#4A5568"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#4A5568"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E1D8"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F5F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#14213D"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#4A5568"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    }
  }
}
